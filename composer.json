{
    "name": "graycorp/zahira-ground-booking",
    "type": "project",
    "description": "Ground booking system for Zahira Green Ground",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.9",
        "inertiajs/inertia-laravel": "^3.0",
        "google/apiclient": "^2.19",
        "symfony/clock": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/string": "^7.4",
        "symfony/translation": "^7.4",
        "symfony/yaml": "^7.4",
        "opcodesio/log-viewer": "^3.24"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
