APP_NAME="Zahira Ground Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zahira_ground_booking
DB_USERNAME=root
DB_PASSWORD=

FILESYSTEM_DISK=public

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="bookings@zahirags.lk"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Booking-specific settings (read via config/booking.php)
# ---------------------------------------------------------------------------

# Comma separated list of email addresses that should get a copy of the
# "new booking" notification IN ADDITION to every admin user account.
# Leave blank to only notify the registered admin accounts.
BOOKING_NOTIFY_EXTRA_EMAILS=

# Bank deposit details shown to the person making the booking
BOOKING_BANK_NAME="Sample Bank PLC"
BOOKING_BANK_ACCOUNT_NAME="Zahira College Ground Fund"
BOOKING_BANK_ACCOUNT_NUMBER="0000000000"
BOOKING_BANK_BRANCH="Colombo Branch"

# WhatsApp number the depositor should send the receipt to (with country code, no + or spaces)
BOOKING_WHATSAPP_NUMBER="94770000000"
BOOKING_SUPPORT_PHONE="0775007470"
BOOKING_SUPPORT_PHONE_2="0772381286"