<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV"                  value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER"   value="file"/>
        <env name="BCRYPT_ROUNDS"            value="4"/>
        <env name="BROADCAST_CONNECTION"     value="null"/>
        <env name="CACHE_STORE"              value="array"/>
        <!-- MariaDB test container (docker-compose.test.yml) -->
        <env name="DB_CONNECTION"            value="mysql"/>
        <env name="DB_HOST"                  value="127.0.0.1"/>
        <env name="DB_PORT"                  value="3307"/>
        <env name="DB_DATABASE"              value="zahira_test"/>
        <env name="DB_USERNAME"              value="zahira_test"/>
        <env name="DB_PASSWORD"              value="zahira_test"/>
        <!-- Emails are captured by Mail::fake() in tests; array driver discards any that slip through -->
        <env name="MAIL_MAILER"              value="array"/>
        <env name="QUEUE_CONNECTION"         value="sync"/>
        <env name="SESSION_DRIVER"           value="array"/>
        <!-- Disable optional integrations that need external credentials -->
        <env name="GOOGLE_CALENDAR_ID"       value=""/>
        <env name="GOOGLE_SERVICE_ACCOUNT_JSON" value=""/>
        <!-- Booking config stubs -->
        <env name="BOOKING_BANK_NAME"        value="Test Bank"/>
        <env name="BOOKING_BANK_ACCOUNT_NAME" value="Test Account"/>
        <env name="BOOKING_BANK_ACCOUNT_NUMBER" value="000000000"/>
        <env name="BOOKING_BANK_BRANCH"      value="Test Branch"/>
        <env name="BOOKING_WHATSAPP_NUMBER"  value="94700000000"/>
    </php>
</phpunit>
